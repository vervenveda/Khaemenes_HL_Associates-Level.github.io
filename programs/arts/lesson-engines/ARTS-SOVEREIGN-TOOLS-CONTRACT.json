  "principle": "Offer Bazaar Art/VNV tools only where they directly support the activity. Tool use is optional, mastery-neutral, and never required over offline or learner-chosen alternatives.",
  "tools": {
    "sketch_lab": {
      "label": "Open Sketch Lab",
      "url": "https://vervenveda.com/bazaarart.github.io/apps/art_tool_sketch_lab_index.html",
      "note": "Quick studies, thumbnails and visual planning."
    },
    "advanced_sketch": {
      "label": "Open Advanced Sketch",
      "url": "https://vervenveda.com/bazaarart.github.io/apps/art_tool_advanced_sketch_index.html",
      "note": "Expanded drawing, layout and composition work."
    },
    "trace_draw": {
      "label": "Open Trace & Draw",
      "url": "https://vervenveda.com/bazaarart.github.io/apps/art_tool_trace_draw_index.html",
      "note": "Observation, alignment and tracing support."
    },
    "color_studio": {
      "label": "Open Color Studio",
      "url": "https://vervenveda.com/bazaarart.github.io/apps/art_tool_color_studio_index.html",
      "note": "Color relationships, mixing logic and palette studies."
    },
    "palette_forge": {
      "label": "Open Palette Forge",
      "url": "https://vervenveda.com/bazaarart.github.io/apps/Game_palette_forge_index.html",
      "note": "Palette experimentation and color decision practice."
    },
    "spinspire": {
      "label": "Open SpinSpire",
      "url": "https://vervenveda.com/bazaarart.github.io/apps/SpinSpire_Art_Prompt_Generator_index.html",
      "note": "Optional prompt constraints when a creative starting point is useful."
    },
    "photo_album": {
      "label": "Open Photo Album Studio",
      "url": "https://vervenveda.com/bazaarart.github.io/apps/Photo_Album_Studio/",
      "note": "Artwork documentation, image organization and portfolio evidence."
    },
    "gallery": {
      "label": "Open My Art Gallery",
      "url": "https://vervenveda.com/myartgallery.github.io/",
      "note": "Portfolio and exhibition presentation."
    },
    "art_resources": {
      "label": "Open Art Resources",
      "url": "https://vervenveda.com/bazaarart.github.io/apps/Art_resources_index.html",
      "note": "Reference and learning resources."
    }
  },
