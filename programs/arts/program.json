  "status": "professional-practice-blueprint-established",
  "practice_model": {
    "philosophy": "Practical working-artist education: create consistently, identify a calling and niche early, build a market-ready portfolio, learn to explain and price the work, and develop a sustainable art career.",
    "year_length_weeks": 36,
    "instructional_days_per_week": 5,
    "minimum_hands_on_studio_days_per_week": 3,
    "curriculum_units_per_course": 13,
    "weekly_spine": {
      "schedule": "5-day professional art practice week",
      "monday": {
        "focus": "Studio Production I",
        "rule": "hands-on making",
        "evidence": "work-in-progress, process photos/notes, technical practice"
      },
      "tuesday": {
        "focus": "Critique · Portfolio · Artist Writing",
        "rule": "reflect, revise, document",
        "evidence": "critique notes, artist statement drafts, portfolio edits"
      },
      "wednesday": {
        "focus": "Studio Production II",
        "rule": "hands-on making",
        "evidence": "new work, technical problem solving, experimentation"
      },
      "thursday": {
        "focus": "Art Business · Marketing · Career Practice",
        "rule": "turn art into a sustainable practice",
        "evidence": "pricing, market research, outreach, contracts/invoices, marketing assets"
      },
      "friday": {
        "focus": "Studio Production III · Finish · Photograph · Archive",
        "rule": "hands-on making plus professional documentation",
        "evidence": "finished work, photography/scans, metadata, inventory record"
      }
    },
    "studio_rule": "At least 60% of scheduled Arts concentration days must produce or materially advance original creative work.",
    "portfolio_rule": "Every completed work considered for the portfolio must be professionally documented, titled/identified, dated, measured where relevant, and entered into the learner inventory.",
    "business_rule": "Business learning is applied to the learner's own developing practice rather than taught only as abstract entrepreneurship."
  }
}
