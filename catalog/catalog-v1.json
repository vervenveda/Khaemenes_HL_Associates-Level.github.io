      "capstone": {
        "code": "ARTS-298",
        "title": "Professional Artist Launch · Portfolio, Exhibition & Business Capstone",
        "units": 6,
        "duration_weeks": 36,
        "curriculum_unit_count": 13,
        "evidence": [
          "minimum curated professional portfolio with cohesive body/bodies of work",
          "short and long artist statements",
          "artist bio and CV/resume",
          "professional artwork photography/scans and inventory",
          "pricing structure and cost model",
          "artist business operations packet",
          "90-day marketing strategy and launch calendar",
          "website/portfolio or equivalent professional presentation",
          "gallery/client/market outreach package",
          "public exhibition, market launch, performance, publication, or equivalent presentation",
          "sales/client simulation or real-world transaction documentation where available",
          "oral defense covering artistic direction, niche, audience, pricing, marketing and next-year career plan"
        ],
        "completion_boundary": "Capstone certifies completion of the non-accredited Associate-Level Arts concentration; it does not certify professional licensure or guarantee gallery representation, sales, employment, or income."
      },
      "practice_model": {
        "philosophy": "Practical working-artist education: create consistently, identify a calling and niche early, build a market-ready portfolio, learn to explain and price the work, and develop a sustainable art career.",
        "year_length_weeks": 36,
        "instructional_days_per_week": 5,
        "minimum_hands_on_studio_days_per_week": 3,
        "curriculum_units_per_course": 13,
        "weekly_spine": {
          "schedule": "5-day professional art practice week",
          "monday": {
            "focus": "Studio Production I",
            "rule": "hands-on making",
            "evidence": "work-in-progress, process photos/notes, technical practice"
          },
          "tuesday": {
            "focus": "Critique · Portfolio · Artist Writing",
            "rule": "reflect, revise, document",
            "evidence": "critique notes, artist statement drafts, portfolio edits"
          },
          "wednesday": {
            "focus": "Studio Production II",
            "rule": "hands-on making",
            "evidence": "new work, technical problem solving, experimentation"
          },
          "thursday": {
            "focus": "Art Business · Marketing · Career Practice",
            "rule": "turn art into a sustainable practice",
            "evidence": "pricing, market research, outreach, contracts/invoices, marketing assets"
          },
          "friday": {
            "focus": "Studio Production III · Finish · Photograph · Archive",
            "rule": "hands-on making plus professional documentation",
            "evidence": "finished work, photography/scans, metadata, inventory record"
          }
        },
        "studio_rule": "At least 60% of scheduled Arts concentration days must produce or materially advance original creative work.",
        "portfolio_rule": "Every completed work considered for the portfolio must be professionally documented, titled/identified, dated, measured where relevant, and entered into the learner inventory.",
        "business_rule": "Business learning is applied to the learner's own developing practice rather than taught only as abstract entrepreneurship.",
        "borrowed_best_practices": {
          "drawing_and_observation": "Retain rigorous drawing/seeing as a lifelong artist tool, not as an academic gatekeeping exercise.",
          "design_2d": "Teach composition, color, imaging and visual communication because working artists must control how work reads.",
          "space_3d": "Require material, object, installation and spatial experimentation so students understand form beyond a flat surface.",
          "time_4d": "Expose every student to sequence, sound, motion, performance and video so they can discover whether time-based practice belongs in their niche.",
          "research": "Use artist research, museums, galleries, archives and living practitioners to strengthen original work, not to replace making.",
          "critique": "Teach critique as a professional revision skill: describe, interpret, question, test intention, revise.",
          "visual_culture": "Place the learner's work in historical, cultural and contemporary context without imposing a single canon.",
          "collaboration": "Require at least one collaborative/community experiment to develop communication and shared-production skills.",
          "sustainability": "Include material safety, waste, reuse and responsible production as practical studio decisions.",
          "audience_and_exhibition": "Teach that work is not fully professional until it can be documented, placed, presented and encountered by an audience."
        }
      }
    },
